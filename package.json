{
  "name": "amrutam-telemedicine-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade backend foundation for the Amrutam telemedicine assignment",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "auth:smoke": "tsx scripts/auth-smoke.ts",
    "availability:smoke": "tsx scripts/availability-smoke.ts",
    "booking:smoke": "tsx scripts/booking-smoke.ts",
    "consultation:smoke": "tsx scripts/consultation-smoke.ts",
    "search:smoke": "tsx scripts/search-smoke.ts",
    "payment:smoke": "tsx scripts/payment-smoke.ts",
    "audit:smoke": "tsx scripts/audit-smoke.ts",
    "analytics:smoke": "tsx scripts/analytics-smoke.ts",
    "observability:smoke": "tsx scripts/observability-smoke.ts",
    "reliability:smoke": "tsx scripts/reliability-smoke.ts",
    "test": "node --import tsx --test tests"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
